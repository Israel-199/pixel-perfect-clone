generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  fullName         String?
  phone            String?
  email            String            @unique
  password         String
  role             Role              @default(USER)
  isSuspended      Boolean           @default(false)
  resetToken       String?
  resetTokenExpiry DateTime?
  loginAttempts    Int               @default(0)   // brute-force protection
  lockedUntil      DateTime?                        // account lockout expiry
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  requests         PurchaseRequest[]
  bookmarks        Bookmark[]
}

model Book {
  id            String            @id @default(uuid())
  title         String
  author        String?           @default("RABBI")
  description   String?
  price         Float             @default(0)
  coverUrl      String
  sampleContent String?           @db.Text
  fullContent   String?           @db.Text
  videoUrl      String?
  audioUrl      String?
  mediaType     String            @default("BOOK") // BOOK, VIDEO, AUDIO, IMAGE
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  requests      PurchaseRequest[]
  bookmarks     Bookmark[]
}

model PurchaseRequest {
  id              String        @id @default(uuid())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  book            Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId          String
  status          RequestStatus @default(PENDING)
  paymentProofUrl String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum Role {
  USER
  ADMIN
}

enum RequestStatus {
  PENDING
  PERMITTED
  REJECTED
}

model PrivatePrayer {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  submittedBy String?
  contactInfo String?
  isPrayed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Bookmark {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId    String
  page      Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
}

model PopupVideo {
  id           String   @id @default("default")
  title        String   @default("About RABBI Digital")
  description  String   @db.Text
  videoUrl     String
  thumbnailUrl String?
  ctaText      String?  @default("ስለ እኛ ተጨማሪ እወቅ")
  ctaLink      String?  @default("/about")
  isActive     Boolean  @default(true)
  autoPlay     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

